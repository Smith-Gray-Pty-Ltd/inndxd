# Inndxd — Environment Configuration
#
# LLM Provider — supports any OpenAI-compatible API
#   OpenAI:     INNDXD_LLM_BASE_URL=https://api.openai.com/v1  INNDXD_LLM_MODEL=gpt-4o       INNDXD_LLM_API_KEY=sk-...
#   Groq:       INNDXD_LLM_BASE_URL=https://api.groq.com/openai/v1  INNDXD_LLM_MODEL=llama-3.3-70b  INNDXD_LLM_API_KEY=gsk_...
#   SiliconFlow: INNDXD_LLM_BASE_URL=https://api.siliconflow.cn/v1  INNDXD_LLM_MODEL=deepseek-ai/DeepSeek-V3  INNDXD_LLM_API_KEY=sk-...
#   DeepSeek:   INNDXD_LLM_BASE_URL=https://api.deepseek.com/v1     INNDXD_LLM_MODEL=deepseek-chat  INNDXD_LLM_API_KEY=sk-...
#   Together:   INNDXD_LLM_BASE_URL=https://api.together.xyz/v1     INNDXD_LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo  INNDXD_LLM_API_KEY=...
#   Local Ollama: INNDXD_LLM_BASE_URL=http://localhost:11434/v1     INNDXD_LLM_MODEL=deepseek-r1:latest
INNDXD_LLM_PROVIDER_NAME=default
INNDXD_LLM_BASE_URL=http://localhost:11434/v1
INNDXD_LLM_API_KEY=ollama
INNDXD_LLM_MODEL=deepseek-r1:latest

INNDXD_DATABASE_URL=postgresql+asyncpg://inndxd:inndxd@localhost:5432/inndxd
INNDXD_REDIS_URL=redis://localhost:6379/0
INNDXD_LOG_LEVEL=INFO
